{
  "name": "stormsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs && node scripts/verify-build.mjs && node scripts/build-pages.mjs && node scripts/verify-pages.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "node scripts/preview-worker.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run build",
    "test:live": "node --import tsx scripts/check-live-alerts.ts --live",
    "resources:stage": "node scripts/stage-resource-explorer.mjs public/resources",
    "predev": "npm run resources:stage",
    "prebuild": "npm run resources:stage",
    "test:resources:ui": "node --test scripts/resource-*.test.mjs",
    "resources:refresh": "node scripts/resources/resource-server.mjs refresh --config resources/sources.json --output resources/catalog.json",
    "resources:serve": "node scripts/resources/resource-server.mjs serve --config resources/sources.json --snapshot resources/catalog.json",
    "test:resources": "node --test scripts/resources/resource-catalog.test.mjs && node scripts/resources/check-catalog.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.1",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
